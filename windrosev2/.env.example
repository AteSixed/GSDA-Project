# Install/update behavior
STEAM_UPDATE_ON_START=1
STEAMCMD_FORCE_PLATFORM_WINDOWS=1

# Runtime build args
WINEHQ_PACKAGE=winehq-stable

# Instance layout (compose default if unset: windrose-main)
SERVER_DATA_SUBDIR=<instanceSubdir>

# Direct connection (must match ServerDescription.json DirectConnectionServerPort)
DIRECT_CONNECTION_PORT=3000

# Headless X server
XVFB_DISPLAY=:99
XVFB_RUN_SCREEN=-screen 0 1024x768x24

# Optional overrides
WINEDEBUG=
SERVER_EXE_OVERRIDE=
GAME_ROOT_OVERRIDE=
